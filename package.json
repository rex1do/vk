{
  "name": "vk-player",
  "productName": "VK Player",
  "version": "3.0.0",
  "description": "Десктопный плеер для официальной ВК Музыки в стиле liquid glass",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.vkplayer",
    "productName": "VK Player",
    "files": [
      "main.js",
      "preload-shell.js",
      "preload-vk.js",
      "shell/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "VKPlayer-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "VKPlayer-Portable-${version}.exe"
    }
  }
}
