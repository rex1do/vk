{
  "name": "vk-player",
  "productName": "VK Player",
  "version": "2.0.0",
  "description": "Отдельное окно для официальной ВК Музыки: трей, фоновое воспроизведение, медиаклавиши",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.vkplayer",
    "productName": "VK Player",
    "files": ["main.js", "build/icon.png"],
    "directories": { "output": "dist" },
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "VKPlayer-Setup-${version}.exe"
    },
    "portable": { "artifactName": "VKPlayer-Portable-${version}.exe" }
  }
}
